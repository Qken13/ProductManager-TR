<UserControl x:Class="ProductManager.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight">

    <Grid Background="#F3F4F6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="White"
        CornerRadius="10"
        Margin="10"
        Padding="15">

            <WrapPanel VerticalAlignment="Center">

                <TextBlock Text=" Satışların Raporları 📊"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,25,0"
                   VerticalAlignment="Center"/>

                <DatePicker x:Name="DpFrom"
                Width="180"
                Height="40"
                Margin="8,0,15,0"/>
                
                <TextBlock Text="'dan"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

                <DatePicker x:Name="DpTo"
                    Width="180"
                    Height="40"
                    Margin="8,0,15,0"/>

                <TextBlock Text="'e "
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

                

                <Button Content="Rapor Görüntüle"
                Width="170"
                Height="42"
                FontWeight="Bold"
                Click="LoadReport_Click"/>

            </WrapPanel>

        </Border>

        <!-- CARDS -->
        <Grid Grid.Row="1" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="5" Background="White" CornerRadius="10">
                <StackPanel Margin="10">
                    <TextBlock Text="Tüm Satışlar 💰"/>
                    <TextBlock x:Name="TxtTotalSales" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="5" Background="White" CornerRadius="10">
                <StackPanel Margin="10">
                    <TextBlock Text="Satılan Ürün Sayısı 📦"/>
                    <TextBlock x:Name="TxtTotalItems" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Margin="5" Background="White" CornerRadius="10">
                <StackPanel Margin="10">
                    <TextBlock Text="Nakit 💵"/>
                    <TextBlock x:Name="TxtCash" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Margin="5" Background="White" CornerRadius="10">
                <StackPanel Margin="10">
                    <TextBlock Text="Kart 💳"/>
                    <TextBlock x:Name="TxtCard" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- RETURN BUTTON -->
        <Button Grid.Row="2"
                Content="İşlemi Sil / İade et 🗑"
                Height="40"
                Margin="10"
                Background="#EF4444"
                Foreground="White"
                FontWeight="Bold"
                Click="ReturnSale_Click"/>

        <!-- TABLE -->
        <Border Grid.Row="3"
                Margin="10"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="GridReport"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Tarih" Binding="{Binding Date}" Width="*"/>
                    <DataGridTextColumn Header="Saat" Binding="{Binding Time}" Width="*"/>
                    <DataGridTextColumn Header="Kod" Binding="{Binding ProductCode}" Width="*"/>
                    <DataGridTextColumn Header="Ürün" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Adet" Binding="{Binding Quantity}" Width="*"/>
                    <DataGridTextColumn Header="Fiyat" Binding="{Binding TotalPrice}" Width="*"/>
                    <DataGridTextColumn Header="Ödeme tipi" Binding="{Binding PaymentType}" Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>